# Симметричный ключ Fernet (AES-256). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dNhNf0cojCPQ52xNMS96Hkmo0-uiF_i7q-IKFHnciUI=

# Legacy alias (если уже задан — можно оставить вместо ENCRYPTION_KEY)
# FIELD_ENCRYPTION_KEY=

# Вход создателя: TOTP (Google Authenticator / Яндекс.Ключ) + резервные коды GRZ-XXXX-XXXX
# Очистка и bootstrap:
#   python scripts/clear_production_db.py --confirm --bootstrap-creator --name "Имя" --email you@corp.ru --tag username
# Или первый аккаунт через /register — QR и backup-коды на экране
# Вход: /login?mode=creator

# SMS.ru — 4-значные коды для входа/регистрации
# Без ключа (пусто) — код печатается в консоль Flask, на шаге SMS вводите 0000
SMS_API_KEY=

# Firebase Cloud Messaging (файл в корне проекта, не коммитить)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
